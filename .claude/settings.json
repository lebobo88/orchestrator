{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "agent": "orchestrator",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateDefaultModel": "sonnet",
  "teammateMode": "in-process",
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(./**/*secret*)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git clean -fd*)"
    ]
  }
}
