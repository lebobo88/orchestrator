{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "agent": "orchestrator",
  "env": {
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0"
  },
  "teammateMode": "in-process",
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -File ./.claude/scripts/statusline.ps1",
    "padding": 1,
    "refreshInterval": 5
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "powershell -NoProfile -File ./.claude/scripts/subagent-statusline.ps1"
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/validate-control-plane-write.ps1"
          }
        ]
      }
    ]
  }
}